    "ink": "^7.1.1",
    "react": "^19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
