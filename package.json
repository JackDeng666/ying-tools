{
  "name": "ying-tools",
  "version": "3.0.0",
  "description": "嘤之工具库",
  "keywords": [
    "嘤",
    "ying",
    "typescript",
    "tool",
    "下载github库",
    "管理切换npm源",
    "图片压缩"
  ],
  "author": "JackDeng666",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackDeng666/ying-tools.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ying": "dist/index.js"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
